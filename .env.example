# FireSight example environment file.
# Copy to `.env` and edit. NEVER commit a real `.env`.
# All values below are placeholders only.

# Application mode: "demo" or "real"
FIRESIGHT_MODE=demo

# SQLite database file (relative to backend/ unless absolute)
FIRESIGHT_DATABASE_URL=sqlite:///./firesight.db

# Root directory that contains user-supplied datasets/sequences
FIRESIGHT_DATA_ROOT=./data

# Path to local YOLO smoke-detection weights (.pt). Leave empty in demo mode.
FIRESIGHT_MODEL_PATH=

# Inference device: auto | cpu | mps | cuda
FIRESIGHT_DEVICE=auto

# Optional vision-language model verification (disabled unless fully configured)
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# API bind settings
FIRESIGHT_API_HOST=127.0.0.1
FIRESIGHT_API_PORT=8000
FIRESIGHT_FRONTEND_PORT=5173
